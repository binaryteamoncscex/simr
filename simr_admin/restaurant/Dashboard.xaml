<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="restaurant.Dashboard"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="*,Auto">
        <RefreshView Grid.Row="0"
                     Command="{Binding RefreshCommand}" 
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="15">
                    <Label Text="{Binding RestaurantName, StringFormat='Welcome, {0}'}"
                           FontSize="24"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"/>

                    <Frame CornerRadius="15" BackgroundColor="#F5F5F5" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Most ordered ingredients" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="Black"/>
                            <Grid HeightRequest="180">
                                <microcharts:ChartView Chart="{Binding MostOrderedIngredientsChart}">
                                    <microcharts:ChartView.Triggers>
                                        <DataTrigger TargetType="microcharts:ChartView" Binding="{Binding IsIngredientsChartAvailable}" Value="False">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </microcharts:ChartView.Triggers>
                                </microcharts:ChartView>
                                <Label Text="Graph not available"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="Gray"
                                       FontAttributes="Italic">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsIngredientsChartAvailable}" Value="True">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            <CollectionView ItemsSource="{Binding IngredientLegend}"
                                            ItemsLayout="VerticalList"
                                            Margin="0,5,0,0">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="10" Padding="5,2">
                                            <BoxView WidthRequest="20" HeightRequest="20" Color="{Binding Color}" CornerRadius="3"/>
                                            <Label Text="{Binding Label}" FontSize="14"/>
                                            <Label Text="{Binding Percentage}" FontSize="14" TextColor="Gray"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame CornerRadius="15" BackgroundColor="#F5F5F5" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Most ordered menu items" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="Black"/>
                            <Grid HeightRequest="180">
                                <microcharts:ChartView Chart="{Binding MostOrderedDishesChart}">
                                    <microcharts:ChartView.Triggers>
                                        <DataTrigger TargetType="microcharts:ChartView" Binding="{Binding IsDishesChartAvailable}" Value="False">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </microcharts:ChartView.Triggers>
                                </microcharts:ChartView>
                                <Label Text="Graph not available"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="Gray"
                                       FontAttributes="Italic">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDishesChartAvailable}" Value="True">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            <CollectionView ItemsSource="{Binding DishLegend}"
                                            ItemsLayout="VerticalList"
                                            Margin="0,5,0,0">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="10" Padding="5,2">
                                            <BoxView WidthRequest="20" HeightRequest="20" Color="{Binding Color}" CornerRadius="3"/>
                                            <Label Text="{Binding Label}" FontSize="14"/>
                                            <Label Text="{Binding Percentage}" FontSize="14" TextColor="Gray"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame CornerRadius="15" BackgroundColor="#F5F5F5" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Monthly Profit (Last 3 Months)" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="Black"/>
                            <Grid HeightRequest="180">
                                <microcharts:ChartView Chart="{Binding MonthlyProfitChart}">
                                    <microcharts:ChartView.Triggers>
                                        <DataTrigger TargetType="microcharts:ChartView" Binding="{Binding IsProfitChartAvailable}" Value="False">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </microcharts:ChartView.Triggers>
                                </microcharts:ChartView>
                                <Label Text="Graph not available"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="Gray"
                                       FontAttributes="Italic">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsProfitChartAvailable}" Value="True">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame CornerRadius="15" BackgroundColor="#F5F5F5" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Monthly Expenses (Last 3 Months)" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="Black"/>
                            <Grid HeightRequest="180">
                                <microcharts:ChartView Chart="{Binding MonthlyExpensesChart}">
                                    <microcharts:ChartView.Triggers>
                                        <DataTrigger TargetType="microcharts:ChartView" Binding="{Binding IsExpensesChartAvailable}" Value="False">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </microcharts:ChartView.Triggers>
                                </microcharts:ChartView>
                                <Label Text="Graph not available"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="Gray"
                                       FontAttributes="Italic">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpensesChartAvailable}" Value="True">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame CornerRadius="15" BackgroundColor="#F5F5F5" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Accounting Summary" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="Black"/>
                            <Grid>
                                <CollectionView ItemsSource="{Binding AccountingTable}"
                                                ItemsLayout="VerticalList"
                                                IsVisible="{Binding IsAccountingTableAvailable}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,*,*,*" 
                                                  Padding="10,5"
                                                  BackgroundColor="Transparent">
                                                <Label Grid.Column="0" Text="{Binding Month}" FontSize="12"/>
                                                <Label Grid.Column="1" Text="{Binding Profit}" FontSize="12" HorizontalTextAlignment="End"/>
                                                <Label Grid.Column="2" Text="{Binding Expenses}" FontSize="12" HorizontalTextAlignment="End"/>
                                                <Label Grid.Column="3" Text="{Binding TotalRevenue}" FontSize="12" HorizontalTextAlignment="End"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                    <CollectionView.Header>
                                        <Grid ColumnDefinitions="*,*,*,*" 
                                              Padding="10,5" 
                                              BackgroundColor="LightGray">
                                            <Label Grid.Column="0" Text="Month" FontSize="12" FontAttributes="Bold"/>
                                            <Label Grid.Column="1" Text="Profit" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="End"/>
                                            <Label Grid.Column="2" Text="Expenses" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="End"/>
                                            <Label Grid.Column="3" Text="Total Revenue" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="End"/>
                                        </Grid>
                                    </CollectionView.Header>
                                </CollectionView>
                                <Label Text="No accounting data available"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="Gray"
                                       FontAttributes="Italic">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsAccountingTableAvailable}" Value="True">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10">
                        <Button Grid.Column="0"
                                Text="Ask AI"
                                BackgroundColor="#6C63FF"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="10"
                                HeightRequest="50"
                                VerticalOptions="Start"
                                Command="{Binding AskAICommand}"/>
                        <Button Grid.Column="1"
                                Text="Download Excel"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="10"
                                HeightRequest="50"
                                VerticalOptions="Start"
                                Command="{Binding DownloadExcelCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Border Grid.Row="1" BackgroundColor="LightSkyBlue" Padding="0" Margin="0" HeightRequest="60" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10,10,0,0"/>
            </Border.StrokeShape>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                <FlexLayout Direction="Row"
                    Wrap="NoWrap"
                    JustifyContent="Start"
                    AlignItems="Center"
                    Padding="5"
                    HeightRequest="60">

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="150">
                        <Image Source="https://i.ibb.co/v65f4Qy1/Untitled43-20250315184559-removebg-preview.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Manage tables" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ManageTablesBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="150">
                        <Image Source="https://i.ibb.co/5gy7661D/Artboard-1-4.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Manage employees" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ManageEmployBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="150">
                        <Image Source="https://i.ibb.co/S41G1mRH/Image-5-iul-2025-13-43-23.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Manage ingredient providers" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ManageIngrProvBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="150">
                        <Image Source="https://i.ibb.co/twYKyhLC/Artboard-1-17.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Manage menu ingredients" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ManageMenuIngrBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="150">
                        <Image Source="https://i.ibb.co/PGZwNC72/mencat.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Manage menu categories" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ManageMenuCatBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="150">
                        <Image Source="https://static.thenounproject.com/png/1092662-200.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Manage menu items" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ManageMenuItemBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="150">
                        <Image Source="https://i.ibb.co/kgyB74YV/clip-art-discounts-and-allowances-transparency-png-favpng-pk81-Qv2-ZFYmxb-E6mv-SVBLWe-Qa-removebg-pr.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Manage discounts" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ManageDiscountsBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="150">
                        <Image Source="https://i.ibb.co/Fq6yp83P/Artboard-1-5.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Check inventory" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CheckInvenBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="180">
                        <Image Source="https://cdn.creazilla.com/cliparts/20285/blue-shopping-basket-clipart-xl.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Pending ingredients orders" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IngrCommands}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="140">
                        <Image Source="https://i.ibb.co/xSfhnQ3p/Captur-de-ecran-2025-10-31-063714-removebg-preview.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Bugs camera" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BugCamera}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="120">
                        <Image Source="https://static.thenounproject.com/png/3070444-200.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="My account" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MyAccountBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid HeightRequest="50" Padding="10,0" ColumnDefinitions="Auto,*" MinimumWidthRequest="120">
                        <Image Source="https://cdn-icons-png.flaticon.com/512/7046/7046204.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Sign Out" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SignOutBtn}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                </FlexLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>