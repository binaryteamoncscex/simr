<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="restaurant.Views.FidelityCardPopup"
               BackgroundColor="White">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Set Fidelity Card" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>
        <Entry x:Name="PurchasesEntry" Placeholder="Number of purchases" Keyboard="Numeric"/>
        <Entry x:Name="ProcentEntry" Placeholder="Discount percent" Keyboard="Numeric"/>
        <Button Text="Confirm" Clicked="OnConfirmClicked" BackgroundColor="LightSkyBlue" TextColor="White"/>
    </VerticalStackLayout>
</toolkit:Popup>
