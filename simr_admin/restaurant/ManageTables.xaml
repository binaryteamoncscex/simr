<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurant.ManageTables"
             Title="Manage Tables"
             BackgroundColor="White">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
        <Button Text="Add Tables"
                BackgroundColor="LightSkyBlue"
                TextColor="White"
                Padding="15"
                WidthRequest="200"
                Command="{Binding AddTablesCommand}" />

        <Button Text="Delete Tables"
                BackgroundColor="LightSkyBlue"
                TextColor="White"
                Padding="15"
                WidthRequest="200"
                Command="{Binding DeleteTablesCommand}" />
    </VerticalStackLayout>
</ContentPage>
