<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurant.AddMenuItem"
             Title="Add Menu Item">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Name" FontAttributes="Bold" />
            <Entry Text="{Binding Name}" Placeholder="Enter the name of the dish" />

            <Label Text="Price" FontAttributes="Bold" />
            <Entry Text="{Binding Price}" Placeholder="Enter the price" Keyboard="Numeric" />

            <Label Text="Photo Link" FontAttributes="Bold" />
            <Entry Text="{Binding Photo}" Placeholder="Enter the photo link" />

            <Label Text="Category" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Categories}" 
                    SelectedItem="{Binding SelectedCategory}">
                <Picker.Title>Select a category</Picker.Title>
            </Picker>

            <Label Text="Allergens Info" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Entry Grid.Column="0" 
                       Text="{Binding Allergens}" 
                       Placeholder="E.g.: Contains nuts, dairy..." />
                <Button Grid.Column="1" 
                        Text="AI Fill" 
                        Command="{Binding AutoCompleteAllergensCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#34A853"
                        TextColor="White"
                        WidthRequest="80"
                        HeightRequest="40"
                        CornerRadius="5"
                        FontSize="12" />
            </Grid>

            <Label Text="Nutritional Info" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Entry Grid.Column="0" 
                       Text="{Binding NutritionalInfo}" 
                       Placeholder="E.g.: 250 kcal per serving..." />
                <Button Grid.Column="1" 
                        Text="AI Fill" 
                        Command="{Binding AutoCompleteNutritionalInfoCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#34A853"
                        TextColor="White"
                        WidthRequest="80"
                        HeightRequest="40"
                        CornerRadius="5"
                        FontSize="12" />
            </Grid>

            <Label Text="Select Ingredients and Quantities" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding IngredientsList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10"
                              ColumnDefinitions="Auto,*,Auto,Auto"
                              VerticalOptions="Center">
                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                VerticalOptions="Center" Color="LightSkyBlue" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding name}"
                                FontSize="16"
                                VerticalOptions="Center"
                                Margin="10,0"
                                TextColor="Black" />
                            <Entry
                                Grid.Column="2"
                                WidthRequest="60"
                                Text="{Binding EnteredQuantity, Mode=TwoWay}"
                                Keyboard="Numeric"
                                Placeholder="Qty"
                                VerticalOptions="Center"
                                IsEnabled="{Binding IsSelected}"
                                PlaceholderColor="LightSkyBlue"
                                TextColor="Black" />
                            <Label
                                Grid.Column="3"
                                Text="{Binding unit}"
                                FontSize="14"
                                VerticalOptions="Center"
                                TextColor="Black"
                                Margin="5,0" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsVisible="{Binding IsBusy}" 
                             IsRunning="{Binding IsBusy}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Color="#34A853" />

            <Button Text="Add Menu Item" 
                    Command="{Binding AddMenuItemCommand}" 
                    BackgroundColor="LightSkyBlue"
                    TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>