<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurant.CheckInven"
             Title="Check Inventory"
             BackgroundColor="White">
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="10">
                <CollectionView ItemsSource="{Binding Ingredients}"
                                SelectionMode="None"
                                BackgroundColor="Transparent">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="5"
                                    StrokeShape="RoundRectangle 10" Stroke="LightGray" Background="White">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="5,5" Radius="10" Opacity="0.3"/>
                                </Border.Shadow>
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           Grid.Row="0" Grid.Column="0"/>
                                    <Label Text="{Binding DaysLeft, StringFormat='Exp. in {0} days'}"
                                           FontSize="14"
                                           TextColor="DarkGreen"
                                           Grid.Row="1" Grid.Column="0">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding DaysLeft}" Value="2">
                                                <Setter Property="TextColor" Value="Red"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding DaysLeft}" Value="1">
                                                <Setter Property="TextColor" Value="Red"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding DaysLeft}" Value="0">
                                                <Setter Property="TextColor" Value="Red"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <HorizontalStackLayout Grid.RowSpan="2" Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding quantity}"
                                               FontSize="18"
                                               TextColor="DarkGray"/>
                                        <Label Text="{Binding unit}"
                                               FontSize="18"
                                               TextColor="DarkGray"
                                               Margin="5,0,0,0"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid ColumnDefinitions="*,Auto,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      Padding="10"
                      ColumnSpacing="30"
                      BackgroundColor="#f2f2f2"
                      Margin="0,20,0,0">

                    <Label Text="" Grid.Row="0" Grid.Column="0" />
                    <Label Text="Temperature"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           Margin="0,0,0,5"
                           Grid.Row="0" Grid.Column="1" />
                    <Label Text="Humidity"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           Margin="0,0,0,5"
                           Grid.Row="0" Grid.Column="2" />

                    <Label Text="Pantry" FontAttributes="Bold" Grid.Row="1" Grid.Column="0" VerticalTextAlignment="Center" />
                    <Label Text="{Binding PantryTemperature}" Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" />
                    <Label Text="{Binding PantryHumidity}" Grid.Row="1" Grid.Column="2" HorizontalOptions="Center" />

                    <Label Text="Fridge" FontAttributes="Bold" Grid.Row="2" Grid.Column="0" VerticalTextAlignment="Center" />
                    <Label Text="{Binding FridgeTemperature}" Grid.Row="2" Grid.Column="1" HorizontalOptions="Center" />
                    <Label Text="{Binding FridgeHumidity}" Grid.Row="2" Grid.Column="2" HorizontalOptions="Center" />

                    <Label Text="Freezer" FontAttributes="Bold" Grid.Row="3" Grid.Column="0" VerticalTextAlignment="Center" />
                    <Label Text="{Binding FreezerTemperature}" Grid.Row="3" Grid.Column="1" HorizontalOptions="Center" />
                    <Label Text="{Binding FreezerHumidity}" Grid.Row="3" Grid.Column="2" HorizontalOptions="Center" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
