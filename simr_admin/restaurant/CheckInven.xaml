<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurant.CheckInven"
             Title="Check Inventory"
             BackgroundColor="White">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <Grid RowDefinitions="*,Auto,Auto" Padding="5" RowSpacing="2">

            <CollectionView ItemsSource="{Binding Ingredients}"
                            SelectionMode="None"
                            Grid.Row="0"
                            VerticalOptions="FillAndExpand"
                            BackgroundColor="Transparent">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="2"
                                StrokeShape="RoundRectangle 10"
                                Stroke="LightGray"
                                Background="White">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="3,3" Radius="6" Opacity="0.2"/>
                            </Border.Shadow>
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       Grid.Row="0" Grid.Column="0"/>
                                <Label Text="{Binding DaysLeft, StringFormat='Exp. in {0} days'}"
                                       FontSize="14"
                                       TextColor="DarkGreen"
                                       Grid.Row="1" Grid.Column="0">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding DaysLeft}" Value="2">
                                            <Setter Property="TextColor" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding DaysLeft}" Value="1">
                                            <Setter Property="TextColor" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding DaysLeft}" Value="0">
                                            <Setter Property="TextColor" Value="Red"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <HorizontalStackLayout Grid.RowSpan="2" Grid.Column="1" HorizontalOptions="End">
                                    <Label Text="{Binding quantity}"
                                           FontSize="18"
                                           TextColor="DarkGray"/>
                                    <Label Text="{Binding unit}"
                                           FontSize="18"
                                           TextColor="DarkGray"
                                           Margin="3,0,0,0"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding Temperature}"
                   FontSize="16"
                   TextColor="DarkBlue"
                   HorizontalOptions="Center"
                   Grid.Row="1"
                   Margin="0,2,0,0" />

            <Label Text="{Binding Humidity}"
                   FontSize="16"
                   TextColor="DarkBlue"
                   HorizontalOptions="Center"
                   Grid.Row="2"
                   Margin="0,1,0,0" />
        </Grid>
    </RefreshView>
</ContentPage>
