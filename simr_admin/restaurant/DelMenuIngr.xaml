<ContentPage
    x:Class="restaurant.DelMenuIngr"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:restaurant.ViewModels"
    x:Name="ThisPage"
    Title="Delete Menu Ingredient">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <VerticalStackLayout Padding="10">
            <Label
                HorizontalOptions="Center"
                FontSize="20"
                Text="Select an ingredient to delete:" />

            <CollectionView ItemsSource="{Binding Ingredients}" SelectionMode="Single">

                <CollectionView.EmptyView>
                    <Label
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"
                        Text="No ingredients found." />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>

                            <SwipeView IsVisible="{OnPlatform Android=true, iOS=true, WinUI=false}">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            BackgroundColor="LightSkyBlue"
                                            Command="{Binding Path=BindingContext.DeleteIngredientCommand, Source={x:Reference ThisPage}}"
                                            CommandParameter="{Binding Key}"
                                            Text="Delete" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid Padding="10">
                                    <Label
                                        FontSize="18"
                                        Text="{Binding Value.name}" />
                                </Grid>
                            </SwipeView>

                            <Frame Padding="10"
                                   Margin="0,5"
                                   BorderColor="#DDD"
                                   BackgroundColor="#FAFAFA"
                                   CornerRadius="12"
                                   HasShadow="True"
                                   IsVisible="{OnPlatform Android=false, iOS=false, WinUI=true}">
                                <VerticalStackLayout>
                                    <Label
                                        FontSize="18"
                                        Text="{Binding Value.name}" />
                                    <Button
                                        Text="Delete"
                                        Margin="0,10,0,0"
                                        BackgroundColor="LightSkyBlue"
                                        TextColor="White"
                                        Command="{Binding Path=BindingContext.DeleteIngredientCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding Key}" />
                                </VerticalStackLayout>
                            </Frame>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </RefreshView>
</ContentPage>
