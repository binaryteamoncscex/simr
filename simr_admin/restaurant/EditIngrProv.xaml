<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurant.EditIngrProv"
             Title="Edit Ingredient Provider">
    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Provider Name" FontAttributes="Bold" />
        <Entry Text="{Binding ProviderName}" IsReadOnly="True" />

        <Label Text="Provider Email" FontAttributes="Bold" />
        <Entry Text="{Binding ProviderEmail}" />

        <Button Text="Save Changes"
                Command="{Binding SaveCommand}"
                BackgroundColor="LightSkyBlue"
                TextColor="White" />

    </VerticalStackLayout>
</ContentPage>
