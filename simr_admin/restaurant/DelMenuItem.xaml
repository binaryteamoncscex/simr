<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="ThisPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurant.DelMenuItem"
             Title="Delete menu item">
    <VerticalStackLayout Padding="10">
        <Label Text="Select an item to delete:" 
               FontSize="20" 
               HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Recipies}"
                        SelectionMode="Single">

            <CollectionView.EmptyView>
                <Label Text="No recipies found." 
                       VerticalOptions="CenterAndExpand" 
                       HorizontalOptions="CenterAndExpand" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid>

                        <SwipeView IsVisible="{OnPlatform Android=true, iOS=true, WinUI=false}">
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Delete" 
                                               BackgroundColor="LightSkyBlue"
                                               Command="{Binding Path=BindingContext.DeleteMenuItemCommand, Source={x:Reference ThisPage}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="10">
                                <Label Text="{Binding name}" 
                                       FontSize="18" />
                            </Grid>
                        </SwipeView>

                        <Frame Padding="10"
                               Margin="0,5"
                               BorderColor="#DDD"
                               BackgroundColor="#FAFAFA"
                               CornerRadius="12"
                               HasShadow="True"
                               IsVisible="{OnPlatform Android=false, iOS=false, WinUI=true}">
                            <VerticalStackLayout>
                                <Label Text="{Binding name}" 
                                       FontSize="18" />
                                <Button Text="Delete"
                                        Margin="0,10,0,0"
                                        BackgroundColor="LightSkyBlue"
                                        TextColor="White"
                                        Command="{Binding Path=BindingContext.DeleteMenuItemCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Frame>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
