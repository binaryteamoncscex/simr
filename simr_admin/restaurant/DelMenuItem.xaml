<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="ThisPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurant.DelMenuItem"
             Title="Manage Menu Items">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="10">
                <CollectionView ItemsSource="{Binding Recipies}"
                                SelectionMode="Single">
                    <CollectionView.EmptyView>
                        <Label Text="No recipies found."
                               VerticalOptions="CenterAndExpand"
                               HorizontalOptions="CenterAndExpand" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <SwipeView IsVisible="{OnPlatform Android=true, iOS=true, WinUI=false, MacCatalyst=false}">
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem Text="Edit"
                                                       BackgroundColor="Orange"
                                                       Command="{Binding Path=BindingContext.EditMenuItemCommand, Source={x:Reference ThisPage}}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Delete"
                                                       BackgroundColor="Salmon"
                                                       Command="{Binding Path=BindingContext.DeleteMenuItemCommand, Source={x:Reference ThisPage}}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Grid Padding="10">
                                        <Label Text="{Binding name}"
                                               FontSize="18" />
                                    </Grid>
                                </SwipeView>

                                <Frame Padding="10"
                                       Margin="0,5"
                                       BorderColor="#DDD"
                                       BackgroundColor="#FAFAFA"
                                       CornerRadius="12"
                                       HasShadow="True"
                                       IsVisible="{OnPlatform Android=false, iOS=false, WinUI=true, MacCatalyst=true}">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding name}"
                                               FontSize="18" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Button Text="Edit"
                                                    BackgroundColor="Orange"
                                                    TextColor="White"
                                                    Command="{Binding Path=BindingContext.EditMenuItemCommand, Source={x:Reference ThisPage}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Delete"
                                                    BackgroundColor="Salmon"
                                                    TextColor="White"
                                                    Command="{Binding Path=BindingContext.DeleteMenuItemCommand, Source={x:Reference ThisPage}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <Button Text="+"
                Command="{Binding AddMenuItem}"
                FontSize="28"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="LightSkyBlue"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20" />
    </Grid>
</ContentPage>
