<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurant.Setup"
             Title="Setup">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Restaurant Name" FontAttributes="Bold" />
            <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Restaurant Name" />

            <Label Text="Local Timezone" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Timezones}"
                    SelectedItem="{Binding SelectedTimezone, Mode=TwoWay}">
                <Picker.Title>
                    <OnPlatform x:TypeArguments="x:String">
                        <On Platform="Android" Value="Select Your Local Timezone" />
                        <On Platform="iOS" Value="Select Your Local Timezone" />
                    </OnPlatform>
                </Picker.Title>
            </Picker>

            <Label Text="Currency" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Currencies}"
                    SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}">
                <Picker.Title>
                    <OnPlatform x:TypeArguments="x:String">
                        <On Platform="Android" Value="Select Currency" />
                        <On Platform="iOS" Value="Select Currency" />
                    </OnPlatform>
                </Picker.Title>
            </Picker>

            <Label Text="Temperature Unit" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding TemperatureUnits}"
                    SelectedItem="{Binding SelectedTemperatureUnit, Mode=TwoWay}">
                <Picker.Title>
                    <OnPlatform x:TypeArguments="x:String">
                        <On Platform="Android" Value="Select Temperature Unit" />
                        <On Platform="iOS" Value="Select Temperature Unit" />
                    </OnPlatform>
                </Picker.Title>
            </Picker>

            <Label Text="Daily Inventory Update Hour" FontAttributes="Bold" />
            <Entry Text="{Binding UpdateHour, Mode=TwoWay}" Placeholder="Daily Inventory Update Hour" Keyboard="Numeric" />

            <Label Text="Drive-thru Available?" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding DriveThruOptions}"
                    SelectedItem="{Binding SelectedDriveThru, Mode=TwoWay}">
                <Picker.Title>
                    <OnPlatform x:TypeArguments="x:String">
                        <On Platform="Android" Value="Do you have a Drive-thru?" />
                        <On Platform="iOS" Value="Do you have a Drive-thru?" />
                    </OnPlatform>
                </Picker.Title>
            </Picker>

            <Button Text="Finish Setup"
                    BackgroundColor="LightSkyBlue"
                    Command="{Binding FinishSetup}"
                    CornerRadius="20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
