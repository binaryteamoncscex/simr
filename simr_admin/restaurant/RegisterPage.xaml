<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="restaurant.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0,30,30"
            Spacing="20"
            VerticalOptions="Start"
            HorizontalOptions="Fill">
            <Image
                Source="https://i.ibb.co/N6tPzSZL/Artboard-1-2.png"
                Aspect="AspectFit"
                HeightRequest="160"
                HorizontalOptions="Fill" />
            <Label
                Text="Register"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="Black" />
            <Entry
                Placeholder="Your Name"
                Text="{Binding Name}"
                FontSize="16"
                HorizontalOptions="Fill" />
            <Entry
                Placeholder="Email"
                Text="{Binding Email}"
                FontSize="16"
                Keyboard="Email"
                HorizontalOptions="Fill" />
            <Entry
                Placeholder="Password"
                Text="{Binding Password}"
                IsPassword="True"
                FontSize="16"
                HorizontalOptions="Fill" />
            <Button
                Text="Sign Up"
                TextColor="White"
                BackgroundColor="DeepSkyBlue"
                FontSize="18"
                CornerRadius="30"
                HeightRequest="50"
                HorizontalOptions="Fill"
                Command="{Binding RegisterUser}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
